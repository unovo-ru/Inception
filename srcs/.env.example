# Central de variables de entorno, de este archivo el docker compose lee estas
# variables y las mete dentro de los contenedores


# DOMINIO Y RUTAS EN EL HOST

# define la direccion wed con la que accedemos al navegador
DOMAIN_NAME=unovo-ru.42.fr
# aqui indicamos la ruta de la VM donde guaramos los archivos
# (los contenedores son efimeros, si no guardamos los datos en algun sitio al cerrar el
# contenedor se perderian esos datos)
DATA_PATH=/home/unovo-ru/data



# CONFIGURACION DE MARIADB

# El nombre de la base de datos vacía que MariaDB creará la primera vez que arranque.
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user






MYSQL_PASSWORD=cambia_esta_password_user
MYSQL_ROOT_PASSWORD=cambia_esta_password_root

# Configuración de WordPress (Sitio y Base de Datos)
WORDPRESS_DB_HOST=mariadb:3306
WORDPRESS_TITLE=Inception 42

# Usuario Administrador de WordPress (PROHIBIDO usar "admin" o similares)
WORDPRESS_ADMIN_USER=unovo-ru
WORDPRESS_ADMIN_PASSWORD=cambia_esta_password_admin
WORDPRESS_ADMIN_EMAIL=unovo-ru@student.42malaga.com

# Segundo usuario de WordPress (obligatorio por subject, rol normal)
WORDPRESS_USER=evaluador
WORDPRESS_USER_PASSWORD=cambia_esta_password_eval
WORDPRESS_USER_EMAIL=evaluador@student.42malaga.com






WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wp_user
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_EMAIL=admin@unovo-ru.42.fr
MARIADB_DATABASE=wordpress
MARIADB_USER=wp_user
